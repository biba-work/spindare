{
  "expo": {
    "name": "Spindare",
    "slug": "spindare",
    "sdkVersion": "55.0.0",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "jsEngine": "hermes",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": false,
      "jsEngine": "hermes",
      "bundleIdentifier": "com.spindare.app",
      "infoPlist": {
        "NSCameraUsageDescription": "SPINDARE needs your camera to capture challenge moments.",
        "NSMicrophoneUsageDescription": "SPINDARE needs your microphone to record challenge videos.",
        "NSPhotoLibraryUsageDescription": "SPINDARE needs your photo library to share challenge moments."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.spindare.app",
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "jsEngine": "hermes",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.VIBRATE",
        "android.permission.INTERNET"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow SPINDARE to access your camera to capture challenge reflections.",
          "microphonePermission": "Allow SPINDARE to access your microphone to record challenge videos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow SPINDARE to access your photos to share challenge moments.",
          "cameraPermission": "Allow SPINDARE to access your camera."
        }
      ],
      "expo-secure-store",
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      "expo-web-browser"
    ],
    "runtimeVersion": "1.0.0",
    "extra": {
      "eas": {
        "projectId": "63795649-304c-41b9-aef2-72f39625676a"
      }
    },
    "owner": "spindare",
    "updates": {
      "url": "https://u.expo.dev/63795649-304c-41b9-aef2-72f39625676a"
    }
  }
}
