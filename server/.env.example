# Postgres connection string. Works with Neon, a fresh Supabase project
# (used purely as Postgres — bypass supabase-js entirely), Railway's managed
# Postgres, or anything else that speaks the Postgres wire protocol.
# Neon/Supabase format: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=

# From your Clerk dashboard → API Keys → Secret Key. This is a *different*
# key from the publishable key the mobile app uses — never ship this one
# inside the mobile app bundle.
CLERK_SECRET_KEY=

# Any S3-compatible object storage. Cloudflare R2 recommended (free tier,
# no egress fees): dash.cloudflare.com → R2 → create bucket → Manage API Tokens.
STORAGE_ENDPOINT=
STORAGE_BUCKET=spindare-assets
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# The public URL your bucket is served from (R2 public bucket URL, or a
# custom domain/CDN in front of it).
STORAGE_PUBLIC_URL=

# From your Stream Chat dashboard — replaces supabase/functions/get-stream-token,
# which died with the Supabase project. STREAM_SECRET must only ever live here,
# never in the mobile app (the app only has STREAM_KEY, which is public-safe).
STREAM_KEY=
STREAM_SECRET=

PORT=3000
